{
    "[markdown]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.quickSuggestions": {
            "other": "on",
            "comments": "off",
            "strings": "off"
        }
    },

    "[plaintext]": {
        "files.insertFinalNewline": false,
        "files.trimFinalNewlines": true
    },

    "markdownlint.run": "onSave",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    "emmet.includeLanguages": {
        "markdown": "html",
    }
}
